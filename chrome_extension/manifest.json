{
  "manifest_version": 3,
  "name": "대표보고 위하고 수집",
  "version": "0.5.2",
  "description": "로그인된 위하고 SmartA 화면에서 분개장·자금계획을 읽어 대표보고 프로그램용 파일로 저장합니다. 위하고에서는 아무것도 바꾸지 않습니다.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://smarta.wehago.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "위하고 수집"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smarta.wehago.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://smarta.wehago.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
